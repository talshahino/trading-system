# Alpaca (free account, Paper is enough): https://app.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Claude API (optional - without it a simple keyword classifier is used)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# End of the model's training data. The test period always starts after it.
MODEL_KNOWLEDGE_CUTOFF=2026-06-30
# USD per million tokens, for the monthly cost estimate
CLAUDE_INPUT_USD_PER_MTOK=0.10
CLAUDE_OUTPUT_USD_PER_MTOK=0.50

# Backtest assumptions
ENTRY_LATENCY_SEC=60
# Cost per round trip, scaled by liquidity score (thin stocks cost more)
COST_BPS_LIQUID=5
COST_BPS_ILLIQUID=40

# Position sizing for the dollar results
EQUITY=10000
# Risk rules
DAILY_LOSS_PCT=2
MAX_DRAWDOWN_PCT=10
RISK_SCALING_POWER=0.5
RISK_SCALE_MIN=0.5
RISK_SCALE_MAX=1.5
RISK_PCT=0.5
MAX_POSITION_PCT=25
MAX_PCT_OF_MINUTE_VOLUME=5
BAR_FEED=sip
RTH_ONLY=1
MAX_SYMBOLS_PER_NEWS=2
TRAIN_FRACTION=0.7
MIN_TRADES_FOR_RULE=30

# Multi-day tracks: returns are measured against the market, as if hedged with SPY
MARKET_SYMBOL=SPY
HEDGE_COST_BPS=2
