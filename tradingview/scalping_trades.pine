indicator("Taloona Trade · סקלפינג", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

symIn   = input.string("אוטומטי", "מכשיר", options=["אוטומטי", "US100", "US30", "US500", "GER40", "FRA40", "JP225", "UK100", "XAUUSD", "EURUSD", "EURJPY", "USDJPY", "GBPUSD", "GBPJPY", "USDCHF", "AUDUSD", "NZDUSD", "WTI", "XAGUSD", "USDCAD", "EURGBP", "EU50", "AUS200"])
showB   = input.bool(true, "עסקאות מהבדיקה ההיסטורית")
showF   = input.bool(true, "עסקאות אמת מהבוט (צפייה)")
showN   = input.bool(true, "מסלול מקורי")
showW   = input.bool(true, "מסלול רחב")
showLeg = input.bool(true, "להראות את הדחף והפער")
oneDay  = input.bool(false, "רק יום אחד")
dayT    = input.time(timestamp("2026-11-09"), "היום להצגה")
maxN    = input.int(150, "מקסימום עסקאות על הגרף", minval=1, maxval=160)

norm(string t) =>
    s = str.replace_all(str.replace_all(str.upper(t), ".CASH", ""), ".", "")
    s
autoSym() =>
    t = norm(syminfo.ticker)
    string r = ""
    r := r == "" and (t == "NAS100" or t == "NAS100USD" or t == "USTEC" or t == "NDX" or t == "NQ1!" or t == "US100") ? "US100" : r
    r := r == "" and (t == "US30" or t == "US30USD" or t == "DJI" or t == "YM1!" or t == "WS30") ? "US30" : r
    r := r == "" and (t == "SPX500" or t == "SPX500USD" or t == "US500" or t == "SPX" or t == "ES1!" or t == "SP500") ? "US500" : r
    r := r == "" and (t == "GER40" or t == "DE40" or t == "DE30EUR" or t == "DAX" or t == "GER30" or t == "DEU40" or t == "FDAX1!") ? "GER40" : r
    r := r == "" and (t == "FRA40" or t == "FR40" or t == "FRA40EUR" or t == "CAC40" or t == "CAC" or t == "FCE1!") ? "FRA40" : r
    r := r == "" and (t == "JP225" or t == "JPN225" or t == "JP225USD" or t == "NI225" or t == "NKD1!") ? "JP225" : r
    r := r == "" and (t == "UK100" or t == "UK100GBP" or t == "FTSE100" or t == "UKX" or t == "FTSE") ? "UK100" : r
    r := r == "" and (t == "USOIL" or t == "WTI" or t == "WTICOUSD" or t == "XTIUSD" or t == "CL1!" or t == "USCRUDE") ? "WTI" : r
    r := r == "" and (t == "EU50" or t == "EUSTX50" or t == "EU50EUR" or t == "SX5E" or t == "STOXX50" or t == "STOXX50E" or t == "FESX1!") ? "EU50" : r
    r := r == "" and (t == "AUS200" or t == "AU200AUD" or t == "ASX200" or t == "XJO" or t == "AUS200AUD") ? "AUS200" : r
    if r == ""
        for s in array.from("XAUUSD", "EURUSD", "EURJPY", "USDJPY", "GBPUSD", "GBPJPY", "USDCHF", "AUDUSD", "NZDUSD", "XAGUSD", "USDCAD", "EURGBP")
            if t == s
                r := s
    r

sym = symIn == "אוטומטי" ? autoSym() : symIn

