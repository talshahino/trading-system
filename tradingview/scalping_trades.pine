f(array<string> a, int i) => array.get(a, i)
num(string v) => v == "" ? float(na) : str.tonumber(v)
ms(string v) => v == "" ? int(na) : int(str.tonumber(v)) * 60000

if barstate.islast
    if sym == ""
        label.new(bar_index, high, "Taloona Trade: המכשיר בגרף לא מזוהה - בחר מכשיר בהגדרות", color=color.orange, textcolor=color.white, style=label.style_label_down)
    else
        recs = str.split(dataOf(sym), ";")
        int shown = 0
        int n = array.size(recs)
        for k = n - 1 to 0
            rec = array.get(recs, k)
            if rec == "" or shown >= maxN
                continue
            a = str.split(rec, ",")
            src = f(a, 0)
            dir = int(num(f(a, 1)))
            flg = f(a, 2)
            wide = str.substring(flg, 0, 1) == "W"
            st = str.substring(flg, 1, 2)
            tIn = ms(f(a, 5))
            okSrc = (src == "B" and showB) or (src == "F" and showF)
            okTrk = (wide and showW) or (not wide and showN)
            okDay = not oneDay or (tIn >= dayT and tIn < dayT + 86400000)
            if okSrc and okTrk and okDay
                shown += 1
                legS = ms(f(a, 3))
                legT = ms(f(a, 4))
                tOut0 = ms(f(a, 6))
                entry = num(f(a, 7))
                stop = num(f(a, 8))
                tgt = num(f(a, 9))
                ex = num(f(a, 10))
                r = num(f(a, 11))
                gLo = num(f(a, 12))
                gHi = num(f(a, 13))
                why = f(a, 14)
                tOut = na(tOut0) ? time + 15 * 60000 : tOut0
                pend = st == "P"
                if showLeg
                    line.new(legS, stop, legT, dir > 0 ? math.max(entry, gHi) : math.min(entry, gLo), xloc=xloc.bar_time, color=color.new(color.blue, 30), style=line.style_dotted, width=2)
                    box.new(legS, gHi, tIn, gLo, xloc=xloc.bar_time, bgcolor=color.new(color.gray, 85), border_color=color.new(color.gray, 50))
                if not na(tgt)
                    box.new(tIn, math.max(entry, tgt), tOut, math.min(entry, tgt), xloc=xloc.bar_time, bgcolor=color.new(color.green, pend ? 88 : 75), border_color=color.new(color.green, 30))
                box.new(tIn, math.max(entry, stop), tOut, math.min(entry, stop), xloc=xloc.bar_time, bgcolor=color.new(color.red, pend ? 88 : 75), border_color=color.new(color.red, 30))
                line.new(tIn, entry, tOut, entry, xloc=xloc.bar_time, color=color.white, width=1)
                side = dir > 0 ? "לונג" : "שורט"
                trk = wide ? "רחב" : "מקורי"
                orig = src == "F" ? "בוט" : "בדיקה"
                res = pend ? "מחכה לכניסה" : st == "O" ? "פתוחה" : why == "T" ? "יעד" : why == "S" ? "סטופ" : "סגירה כפויה"
                rTxt = na(r) ? "" : " · " + str.tostring(r, "#.##") + "R"
                txt = side + " · " + trk + " · " + orig + "\n" + res + rTxt + "\nכניסה " + str.tostring(entry, format.mintick) + "\nסטופ " + str.tostring(stop, format.mintick) + (na(tgt) ? "" : "\nיעד " + str.tostring(tgt, format.mintick))
                lc = pend ? color.gray : na(r) ? color.blue : r > 0 ? color.green : color.red
                label.new(tIn, dir > 0 ? math.min(entry, stop) : math.max(entry, stop), txt, xloc=xloc.bar_time, color=lc, textcolor=color.white, size=size.small, style=dir > 0 ? label.style_label_up : label.style_label_down)
                if not na(ex) and not pend
                    label.new(tOut, ex, "", xloc=xloc.bar_time, color=lc, style=label.style_circle, size=size.tiny)
